# Copy to .env to override local defaults. Never commit .env.
# `docker compose up` works without this file; every variable has a
# development default. Variables are added here as the code starts reading them.

# --- Compose: Postgres ---
# POSTGRES_USER owns the schema and runs migrations. The api connects as app_rw.
# Keep passwords URL-safe: Compose builds connection URLs from them.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=manga_novel
APP_RW_PASSWORD=app_rw

# --- Compose: MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Compose: host ports. Change one if it is already taken on your machine. ---
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8000
OLLAMA_PORT=11434

# --- Running api, alembic or tests on the host (outside Compose) ---
# Must agree with the values above, including POSTGRES_PORT.
DATABASE_URL=postgresql+asyncpg://app_rw:app_rw@127.0.0.1:5432/manga_novel
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/manga_novel
REDIS_URL=redis://127.0.0.1:6379/0
LOG_LEVEL=INFO
# Tests start their own Postgres through Testcontainers unless this is set
# (owner role, on a database that only tests use).
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/manga_novel_test
# Likewise for Redis. Tests write under their own key prefix and never flush.
# TEST_REDIS_URL=redis://127.0.0.1:6379/0
