# Copy to .env to override local defaults. Never commit .env.
# `docker compose up` works without this file; every variable has a
# development default. Variables are added here as the code starts reading them.

# --- Compose: Postgres ---
# POSTGRES_USER owns the schema and runs migrations. The api connects as app_rw.
# Keep passwords URL-safe: Compose builds connection URLs from them.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=manga_novel
APP_RW_PASSWORD=app_rw

# --- Compose: MinIO ---
# The api and the worker sign in with these too (S3_ACCESS_KEY / S3_SECRET_KEY).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Clients upload to and read from MinIO directly, at the address URLs are signed
# for. For a phone on the LAN, use the machine's LAN address and open the port:
# S3_PUBLIC_ENDPOINT_URL=http://192.168.1.20:9000
# MINIO_BIND=0.0.0.0

# --- Auth ---
# ENVIRONMENT other than "local" turns on Secure cookies and refuses the
# development JWT_SECRET. Generate a real one with: openssl rand -hex 32
ENVIRONMENT=local
JWT_SECRET=local-development-jwt-secret-do-not-use-elsewhere
# Browser origins allowed to call the API with credentials, as a JSON list.
CORS_ORIGINS=["http://localhost:8081"]

# --- Compose: host ports. Change one if it is already taken on your machine. ---
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8000
OLLAMA_PORT=11434

# --- Running api, alembic or tests on the host (outside Compose) ---
# Must agree with the values above, including POSTGRES_PORT.
DATABASE_URL=postgresql+asyncpg://app_rw:app_rw@127.0.0.1:5432/manga_novel
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/manga_novel
REDIS_URL=redis://127.0.0.1:6379/0
LOG_LEVEL=INFO
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
# ENVIRONMENT other than "local" refuses this development secret.
S3_SECRET_KEY=minioadmin
# Tests start their own Postgres through Testcontainers unless this is set
# (owner role, on a database that only tests use).
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/manga_novel_test
# Likewise for Redis. Tests write under their own key prefix and never flush.
# TEST_REDIS_URL=redis://127.0.0.1:6379/0
