{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run alembic upgrade:*)",
      "Bash(uv run alembic history:*)",
      "Bash(uv run alembic current:*)",
      "Bash(uv run alembic revision:*)",
      "Bash(uv run python -m worker:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run gen:api)",
      "Bash(npx expo lint:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Bash(uv run alembic downgrade:*)",
      "Bash(docker compose down -v:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-edits.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-python.py"
          }
        ]
      }
    ]
  }
}
